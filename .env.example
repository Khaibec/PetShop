# Database Connection String
ConnectionStrings__DefaultConnection=Server=localhost;Database=PetShopDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;

# JWT Authentication
Jwt__Key=YourSuperSecretKeyWithLongEnoughEntropyHere!
Jwt__Issuer=PetShopApi
Jwt__Audience=PetShopClient

# OAuth Providers
Authentication__Google__ClientId=your-google-client-id.apps.googleusercontent.com
Authentication__Google__ClientSecret=your-google-client-secret

Authentication__Facebook__AppId=your-facebook-app-id
Authentication__Facebook__AppSecret=your-facebook-app-secret

Authentication__GitHub__ClientId=your-github-client-id
Authentication__GitHub__ClientSecret=your-github-client-secret
